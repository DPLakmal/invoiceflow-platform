# ==========================================
# InvoiceFlow Platform Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=invoiceflow-super-secret-key-change-in-production-2026

# Backend Service
API_V1_PREFIX=/api/v1
PROJECT_NAME="InvoiceFlow Platform"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:4200","http://localhost:80","http://localhost:3000","capacitor://localhost","http://localhost"]

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=invoiceflow_secure_password
POSTGRES_DB=invoiceflow_db
DATABASE_URL=postgresql://invoiceflow:invoiceflow_secure_password@postgres:5432/invoiceflow_db

# Local SQLite fallback for standalone non-docker dev/testing
# DATABASE_URL=sqlite:///./invoiceflow.db

# Redis Broker & Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf","png","jpg","jpeg","tiff"]

# OCR Settings
TESSERACT_CMD=tesseract
POPPLER_PATH=
CONFIDENCE_THRESHOLD=0.85
